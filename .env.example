# Copy to .env and add your keys. .env is gitignored and must never be committed.
# TRIGGER reproduces the headline number fully offline from data/cache/ with
# NONE of these set. They are only needed to fetch new data or re-compile.

# Thermal data. Needed only to analyse a window that is not already cached.
FORTYGUARD_API_KEY=your_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Clause compiler. Needed only to RE-compile the plan; the compiled output and
# the measured F1 are committed. Free Google AI Studio tier is sufficient.
GEMINI_API_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=            # optional alternative provider, see src/llm.py

# Population weighting. Needed only to rebuild data/zones population figures.
CENSUS_API_KEY=your_census_key_here
